# Copy to .env and replace all placeholder credentials before starting services.
POSTGRES_USER=leaderboard
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_DB=leaderboard
JWT_SECRET=replace-with-a-long-random-local-jwt-secret
REDIS_PASSWORD=replace-with-a-local-redis-password

KAFKA_HOST_PORT=9092
API_HOST_PORT=8080
QUERY_HOST_PORT=50053
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
